# Server
PORT=5000
NODE_ENV=development

# Database
# Default is SQLite — zero setup, no server required. Just leave DB_DIALECT as-is.
# Switch to DB_DIALECT=mysql only when you're ready to point at a real MySQL server.
DB_DIALECT=sqlite
DB_STORAGE=./dev.sqlite

# MySQL settings (only used when DB_DIALECT=mysql above)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mf_intelligence
DB_USER=root
DB_PASSWORD=changeme

# Auth
JWT_SECRET=xghtrm
JWT_EXPIRES_IN=8h

# Uploads
UPLOAD_DIR=./uploads

# Default super admin (created by seed script if not present)
SEED_ADMIN_EMAIL=admin@gmail.com
SEED_ADMIN_PASSWORD=Admin@123


